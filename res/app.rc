#include <windows.h>

1 ICON "app.ico"

1 VERSIONINFO
FILEVERSION     0,1,0,0
PRODUCTVERSION  0,1,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Audio Monitor"
            VALUE "FileVersion",     "0.1.0.0"
            VALUE "InternalName",    "audio-monitor"
            VALUE "OriginalFilename","audio-monitor.exe"
            VALUE "ProductName",     "Audio Monitor"
            VALUE "ProductVersion",  "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
